# =====================================================================================
# PKDB – Personal Knowledge Database configuration
# Copy to ".env", adjust, then run:  docker compose up -d
# =====================================================================================

# ---------- Network / access ---------------------------------------------------------
# Option A (LAN / localhost): leave PKDB_HOST empty. The wiki is served via plain HTTP on HTTP_PORT.
# Option B (own domain): set PKDB_HOST to a DNS name pointing to this server. Caddy then gets a
#   Let's Encrypt certificate automatically (ports 80 + 443 must be reachable from the internet),
#   or set TLS_MODE=internal for a self-signed certificate inside your LAN.
PKDB_HOST=
HTTP_PORT=80
HTTPS_PORT=443
TLS_MODE=
ACME_EMAIL=
# URL under which you open the wiki in the browser (used for links in search results and as
# the Wiki.js site URL). Default: https://PKDB_HOST, or http://localhost[:HTTP_PORT]
PUBLIC_URL=

# ---------- Authentication ------------------------------------------------------------
# AUTH_MODE=builtin  -> Wiki.js login. The browser extension logs in with a wiki account.
# AUTH_MODE=authelia -> Authelia (single sign-on portal) in front of the wiki. Needs PKDB_HOST,
#                       AUTH_HOST and COMPOSE_PROFILES=authelia. The extension API keeps using tokens.
AUTH_MODE=builtin
# Make wiki pages (and embedded maps) readable without login. Editing always needs a login,
# and the extension API always needs a token.
WIKI_PUBLIC=false

# Static API tokens for the extension (comma separated, optional). Normally you just log in from
# the extension's settings with your wiki account instead.
PKDB_API_TOKENS=

# --- Only for AUTH_MODE=authelia ---
# COMPOSE_PROFILES=authelia
# AUTH_HOST=auth.example.com            # login portal, must share a parent domain with PKDB_HOST
# AUTH_COOKIE_DOMAIN=example.com        # default: PKDB_HOST without its first label
# AUTH_ADMIN_USER=admin
# AUTH_ADMIN_PASSWORD=change-me-please
# AUTH_ADMIN_EMAIL=you@example.com
# AUTH_POLICY=one_factor                # or two_factor (TOTP; setup codes go to /config/notification.txt)

# ---------- Database --------------------------------------------------------------------
POSTGRES_DB=pkdb
POSTGRES_USER=pkdb
POSTGRES_PASSWORD=change-me-db-password
# For ARM machines (e.g. Raspberry Pi) use a multi-arch PostGIS image, e.g.:
# POSTGIS_IMAGE=imresamu/postgis:16-3.4

# ---------- Wiki ------------------------------------------------------------------------
# The admin account is created automatically on first start (password: at least 8 characters).
WIKI_ADMIN_EMAIL=admin@example.com
WIKI_ADMIN_PASSWORD=change-me-wiki-password
WIKI_TITLE=Knowledge Base
# Language the LLM writes wiki articles in (ISO code, e.g. de, en). Also used for search stemming.
WIKI_LANGUAGE=de
# Wiki.js page locale (leave "en" unless you installed other locales in Wiki.js)
WIKI_LOCALE=en

# ---------- LLM ------------------------------------------------------------------------
# LLM_PROVIDER=openai    -> any OpenAI compatible API: OpenAI, Ollama, LM Studio, OpenRouter, vLLM, ...
# LLM_PROVIDER=anthropic -> Anthropic Claude API
#
# Examples:
#   OpenAI:     LLM_PROVIDER=openai  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4.1-mini
#   Ollama:     LLM_PROVIDER=openai  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen2.5:14b
#               (uncomment extra_hosts for the backend in docker-compose.yml)
#   OpenRouter: LLM_PROVIDER=openai  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=...
#   Claude:     LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5-5
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=600
# Ask the API for JSON output (disable if your server rejects response_format)
LLM_JSON_MODE=true
# How many related pages the LLM may edit per submission and how much of each page it sees
LLM_MAX_RELATED_PAGES=5
LLM_CONTEXT_CHARS=12000
# "review": proposed changes wait for your approval in the extension (default)
# "auto":   changes are written to the wiki immediately (page history allows rollback)
# The extension can override this per submission.
LLM_APPLY_MODE=review
# Extra instructions appended to the LLM prompt, e.g. house style or naming conventions
LLM_EXTRA_INSTRUCTIONS=

# ---------- Search ----------------------------------------------------------------------
# Share of search words that must match for a result to be shown (0.0 – 1.0)
SEARCH_MIN_MATCH=0.5
SEARCH_MAX_RESULTS=5

# ---------- Limits ----------------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_FEATURES_PER_LAYER=50000

# ---------- Images ----------------------------------------------------------------------
# Docker image owner / tag (change if you build the images in your own fork)
PKDB_IMAGE_OWNER=finn-freitag
PKDB_VERSION=latest
TZ=Europe/Berlin
